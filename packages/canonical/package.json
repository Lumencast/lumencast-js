{
  "name": "@lumencast/canonical",
  "version": "0.18.0",
  "description": "Canonical JSON form and content address for LSML bundles (LSML 1.0 §3). Leaf package, no internal dependency — the single canonicalizer shared by the compiler and the protocol conformance harness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/Lumencast/lumencast-js/tree/main/packages/canonical",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumencast/lumencast-js.git",
    "directory": "packages/canonical"
  },
  "keywords": [
    "lumencast",
    "lsml",
    "canonical",
    "content-address"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
